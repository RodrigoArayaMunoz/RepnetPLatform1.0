# Docker Compose activates this measured profile by default in all writers.
# Optional overrides: merge into deploy/.env on the VPS (not the backend .env).
# For local Docker Compose, use the backend .env or exported shell variables.
# Do not replace existing secrets or commit the real environment files.
# The write budget is shared by price/stock, pictures and compatibilities.
# All writers of this app must use the same Redis and the same global budget.
ML_WRITE_REQUESTS_PER_SECOND=4
ML_WRITE_MAX_REQUESTS_PER_WINDOW=240
ML_WRITE_WINDOW_SECONDS=60
ML_RETRY_429_COOLDOWN_SECONDS=60
PRICE_STOCK_CHUNK_SIZE=300
PRICE_STOCK_CHUNK_PAUSE_SECONDS=0
PRICE_STOCK_MAX_CONCURRENCY=4
JOB_PROGRESS_UPDATE_EVERY=25
